# ==============================================================================
# PrivyChain Backend Configuration Template (.env.example)
#
# NOTE: The backend NEVER requires private keys or transaction signers.
# ==============================================================================

# Server Port
BACKEND_PORT=4000

# MST Coral Testnet RPC URL
MST_TESTNET_RPC_URL=https://coralrpc.mstblockchain.com

# MST Coral Testnet Chain ID (54635 / 0xd56b)
MST_TESTNET_CHAIN_ID=54635

# Block Explorer URL
MST_TESTNET_EXPLORER_URL=https://coral.mstscan.com

# Public Contract Addresses (Populate after Phase 6 deployment)
REGISTRY_CONTRACT_ADDRESS=PENDING_DEPLOYMENT
PERMISSION_MANAGER_CONTRACT_ADDRESS=PENDING_DEPLOYMENT
