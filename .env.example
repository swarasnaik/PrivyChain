# ==============================================================================
# PrivyChain Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your testnet private key (with testnet tMSTC from the faucet)
# 3. NEVER commit your '.env' file or share your private key.
# ==============================================================================

# MST Coral Testnet RPC Endpoint
MST_TESTNET_RPC_URL=https://coralrpc.mstblockchain.com

# MST Coral Testnet Chain ID (Live verified: 54635 / 0xd56b)
MST_TESTNET_CHAIN_ID=54635

# Deployer Private Key for MST Coral Testnet (Do NOT include '0x' prefix; NEVER commit real keys)
# Obtain test tokens (tMSTC) at: https://coral-faucet.mstblockchain.com
DEPLOYER_PRIVATE_KEY=your_64_character_hex_private_key_here

# Block Explorer
MST_TESTNET_EXPLORER_URL=https://coral.mstscan.com
